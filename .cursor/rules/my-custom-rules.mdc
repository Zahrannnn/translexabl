### Axios Client Setup
```typescript
// lib/api/clients/base.ts
import axios, { AxiosInstance, AxiosRequestConfig } from 'axios'
import { cookies } from 'next/headers'
import { env } from '@/lib/env'

// Cookie utilities for client-side
export const cookieUtils = {
  get: (name: string): string | null => {
    if (typeof document === 'undefined') return null
    const value = `; ${document.cookie}`
    const parts = value.split(`; ${name}=`)
    if (parts.length === 2) return parts.pop()?.split(';').shift() || null
    return null
  },
  
  set: (name: string, value: string, options: {
    httpOnly?: boolean
    secure?: boolean
    sameSite?: 'strict' | 'lax' | 'none'
    maxAge?: number
    path?: string
  } = {}) => {
    if (typeof document === 'undefined') return
    
    const {
      httpOnly = false, // Can't set httpOnly from client-side
      secure = true,
      sameSite = 'strict',
      maxAge = 7 * 24 * 60 * 60, // 7 days
      path = '/'
    } = options
    
    let cookieString = `${name}=${value}; path=${path}; max-age=${maxAge}; samesite=${sameSite}`
    if (secure) cookieString += '; secure'
    
    document.cookie = cookieString
  },
  
  remove: (name: string, path: string = '/') => {
    if (typeof document === 'undefined') return
    document.cookie = `${name}=; path=${path}; expires=Thu, 01 Jan 1970 00:00:01 GMT`
  }
}

const createApiClient = (baseURL: string): AxiosInstance => {
  const client = axios.create({
    baseURL,
    timeout: 10000,
    withCredentials: true, // Important: Send cookies with requests
    headers: {
      'Content-Type': 'application/json',
    },
  })

  // Request interceptor
  client.interceptors.request.use(
    (config) => {
      // For server-side requests (SSR/API routes)
      if (typeof window === 'undefined') {
        // Use Next.js cookies() for server-side
        try {
          const cookieStore = cookies()
          const token = cookieStore.get('auth_token')?.value
          if (token) {
            config.headers.Authorization = `Bearer ${token}`
          }
        } catch (error) {
          // Cookies might not be available in all server contexts
          console.warn('Could not access cookies on server:', error)
        }
      } else {
        // For client-side requests
        const token = cookieUtils.get('auth_token')
        if (token) {
          config.headers.Authorization = `Bearer ${token}`
        }
      }
      return config
    },
    (error) => Promise.reject(error)
  )

  // Response interceptor
  client.interceptors.response.use(
    (response) => response,
    async (error) => {
      const originalRequest = error.config
      
      if (error.response?.status === 401 && !originalRequest._retry) {
        originalRequest._retry = true
        
        try {
          // Call refresh token endpoint
          const refreshToken = cookieUtils.get('refresh_token')
          if (!refreshToken) {
            throw new Error('No refresh token available')
          }

          const refreshResponse = await axios.post(`${baseURL}/auth/refresh`, {
            refreshToken
          }, {
            withCredentials: true
          })

          // Server should set new tokens in HTTP-only cookies
          // No need to manually handle token storage here
          
          // Retry the original request
          return client(originalRequest)
        } catch (refreshError) {
          // Clear auth cookies and redirect to login
          cookieUtils.remove('auth_token')
          cookieUtils.remove('refresh_token')
          
          if (typeof window !== 'undefined') {
            window.location.href = '/login'
          }
          return Promise.reject(refreshError)
        }
      }
      
      return Promise.reject(error)
    }
  )

  return client
}

export const apiClient = createApiClient(env.API_BASE_URL)

// Server-side API client for API routes and server components
export const createServerApiClient = async (): Promise<AxiosInstance> => {
  const cookieStore = await cookies()
  const token = cookieStore.get('auth_token')?.value

  return axios.create({
    baseURL: env.API_BASE_URL,
    timeout: 10000,
    headers: {
      'Content-Type': 'application/json',
      ...(token && { Authorization: `Bearer ${token}` }),
    },
  })
}
```

### Service Layer Pattern
```typescript
// lib/api/services/authService.ts
import { z } from 'zod'
import { apiClient, cookieUtils } from '../clients/base'

export const LoginSchema = z.object({
  email: z.string().email(),
  password: z.string().min(1),
})

export const RegisterSchema = z.object({
  name: z.string().min(2),
  email: z.string().email(),
  password: z.string().min(8),
})

export const AuthResponseSchema = z.object({
  user: z.object({
    id: z.string(),
    name: z.string(),
    email: z.string().email(),
    role: z.string(),
  }),
  // Note: tokens are set in HTTP-only cookies by the server
})

export type LoginData = z.infer<typeof LoginSchema>
export type RegisterData = z.infer<typeof RegisterSchema>
export type AuthResponse = z.infer<typeof AuthResponseSchema>

export class AuthService {
  static async login(credentials: LoginData): Promise<AuthResponse> {
    const validatedData = LoginSchema.parse(credentials)
    
    const response = await apiClient.post('/auth/login', validatedData)
    
    // Server sets HTTP-only cookies automatically
    // auth_token (HTTP-only, Secure, SameSite=Strict)
    // refresh_token (HTTP-only, Secure, SameSite=Strict)
    
    return AuthResponseSchema.parse(response.data)
  }

  static async register(userData: RegisterData): Promise<AuthResponse> {
    const validatedData = RegisterSchema.parse(userData)
    
    const response = await apiClient.post('/auth/register', validatedData)
    
    return AuthResponseSchema.parse(response.data)
  }

  static async logout(): Promise<void> {
    try {
      // Call server logout endpoint to clear HTTP-only cookies
      await apiClient.post('/auth/logout')
    } finally {
      // Clear any client-side cookies (fallback)
      cookieUtils.remove('auth_token')
      cookieUtils.remove('refresh_token')
      
      // Redirect to login
      if (typeof window !== 'undefined') {
        window.location.href = '/login'
      }
    }
  }

  static async refreshToken(): Promise<void> {
    // Refresh endpoint handles cookie renewal automatically
    await apiClient.post('/auth/refresh')
  }

  static async getCurrentUser(): Promise<AuthResponse['user']> {
    const response = await apiClient.get('/auth/me')
    
    return z.object({
      id: z.string(),
      name: z.string(),
      email: z.string().email(),
      role: z.string(),
    }).parse(response.data)
  }

  static isAuthenticated(): boolean {
    // Check if auth token exists in cookies
    return !!cookieUtils.get('auth_token')
  }
}
```
```typescript
// lib/api/services/userService.ts
import { z } from 'zod'
import { apiClient } from '../clients/base'

// Zod schemas for validation
export const UserSchema = z.object({
  id: z.string(),
  name: z.string(),
  email: z.string().email(),
  avatar: z.string().url().optional(),
  createdAt: z.string().datetime(),
})

export const CreateUserSchema = z.object({
  name: z.string().min(2),
  email: z.string().email(),
  password: z.string().min(8),
})

export const UpdateUserSchema = CreateUserSchema.partial()

export type User = z.infer<typeof UserSchema>
export type CreateUserData = z.infer<typeof CreateUserSchema>
export type UpdateUserData = z.infer<typeof UpdateUserSchema>

// Service class
export class UserService {
  private static readonly BASE_PATH = '/users'

  static async getUsers(params?: {
    page?: number
    limit?: number
    search?: string
  }): Promise<{ users: User[]; total: number; page: number }> {
    const response = await apiClient.get(this.BASE_PATH, { params })
    
    // Validate response data
    const schema = z.object({
      users: z.array(UserSchema),
      total: z.number(),
      page: z.number(),
    })
    
    return schema.parse(response.data)
  }

  static async getUserById(id: string): Promise<User> {
    const response = await apiClient.get(`${this.BASE_PATH}/${id}`)
    return UserSchema.parse(response.data)
  }

  static async createUser(userData: CreateUserData): Promise<User> {
    const validatedData = CreateUserSchema.parse(userData)
    const response = await apiClient.post(this.BASE_PATH, validatedData)
    return UserSchema.parse(response.data)
  }

  static async updateUser(id: string, userData: UpdateUserData): Promise<User> {
    const validatedData = UpdateUserSchema.parse(userData)
    const response = await apiClient.patch(`${this.BASE_PATH}/${id}`, validatedData)
    return UserSchema.parse(response.data)
  }

  static async deleteUser(id: string): Promise<void> {
    await apiClient.delete(`${this.BASE_PATH}/${id}`)
  }
}
